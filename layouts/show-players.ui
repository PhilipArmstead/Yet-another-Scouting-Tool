<?xml version="1.0" encoding="UTF-8"?>
<!--
  FM Player Rater - GTK4 GtkBuilder UI definition.
  See: https://docs.gtk.org/gtk4/class.Builder.html
-->
<interface domain="show-players">
	<!-- interface-name show-players.ui -->
	<!-- interface-copyright SPDX-FileCopyrightText: © 2026 Phil Armstead <philarmstead@mailbox.org>
SPDX-License-Identifier: GPL-3.0-or-later -->
	<!-- interface-authors Phil Armstead <philarmstead@mailbox.org> -->
	<requires lib="gtk" version="4.0"/>
	<object class="GtkWindow" id="window:show-players">
		<property name="title">FM Player Rater</property>
		<property name="default-width">1255</property>
		<property name="default-height">690</property>
		<child>
			<object class="GtkBox">
				<property name="orientation">vertical</property>
				<property name="css-classes">app-root</property>
				<child>
					<object class="GtkBox">
						<property name="css-classes">topbar</property>
						<property name="spacing">10</property>
						<child>
							<object class="GtkButton">
								<property name="label">Players</property>
								<style>
									<class name="nav-tab"/>
									<class name="nav-tab-active"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Current player</property>
								<signal name="clicked" handler="callbacks_onShowCurrentPlayer"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Best XI</property>
								<signal name="clicked" handler="callbacks_onShowBestEleven"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Squad Depth</property>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkBox">
								<property name="hexpand">true</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel" id="label:date">
								<property name="label"/>
								<style>
									<class name="date"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkLabel" id="label:status">
								<property name="label"/>
								<style>
									<class name="version"/>
								</style>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="GtkBox">
						<property name="css-classes">filterbar</property>
						<property name="spacing">8</property>
						<child>
							<object class="GtkLabel" id="label:results-count">
								<style>
									<class name="results-count"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkBox" id="box:filter-tags"/>
						</child>
						<child>
							<object class="GtkButton" id="button:clear-all">
								<property name="label">clear all</property>
								<signal name="clicked" handler="callbacks_onFiltersClear"/>
								<style>
									<class name="link-btn"/>
								</style>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="GtkBox">
						<property name="orientation">horizontal</property>
						<property name="vexpand">true</property>
						<property name="css-classes">body</property>
						<child>
							<object class="GtkBox" id="sidebar">
								<property name="orientation">vertical</property>
								<property name="width-request">190</property>
								<property name="spacing">6</property>
								<property name="css-classes">sidebar</property>
								<child>
									<object class="GtkBox" id="box:club-search-container"/>
								</child>
								<child>
									<object class="GtkBox">
										<property name="css-classes">sidebar-section-header</property>
										<property name="spacing">6</property>
										<child>
											<object class="GtkLabel">
												<property name="label">POSITION</property>
												<property name="halign">start</property>
												<property name="hexpand">false</property>
												<style>
													<class name="section-title"/>
												</style>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label">▸</property>
												<style>
													<class name="section-chevron"/>
												</style>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="css-classes">sidebar-section-header</property>
										<property name="spacing">6</property>
										<child>
											<object class="GtkLabel">
												<property name="label">QUALITY &amp; AGE</property>
												<property name="halign">start</property>
												<property name="hexpand">false</property>
												<style>
													<class name="section-title"/>
												</style>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label">▾</property>
												<style>
													<class name="section-chevron"/>
												</style>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="orientation">vertical</property>
										<property name="spacing">6</property>
										<property name="css-classes">quality-body</property>
										<child>
											<object class="GtkBox">
												<property name="spacing">4</property>
												<style>
													<class name="quality-row"/>
												</style>
												<child>
													<object class="GtkLabel">
														<property name="label">Age</property>
														<property name="halign">start</property>
														<style>
															<class name="quality-label"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:age:min">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
												<child>
													<object class="GtkLabel">
														<property name="label">-</property>
														<style>
															<class name="quality-dash"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:age:max">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="spacing">4</property>
												<style>
													<class name="quality-row"/>
												</style>
												<child>
													<object class="GtkLabel">
														<property name="label">CA</property>
														<property name="halign">start</property>
														<style>
															<class name="quality-label"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:ca:min">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
												<child>
													<object class="GtkLabel">
														<property name="label">-</property>
														<style>
															<class name="quality-dash"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:ca:max">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="spacing">4</property>
												<style>
													<class name="quality-row"/>
												</style>
												<child>
													<object class="GtkLabel">
														<property name="label">PA</property>
														<property name="halign">start</property>
														<style>
															<class name="quality-label"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:pa:min">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
												<child>
													<object class="GtkLabel">
														<property name="label">-</property>
														<style>
															<class name="quality-dash"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:pa:max">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="spacing">4</property>
												<style>
													<class name="quality-row"/>
												</style>
												<child>
													<object class="GtkLabel">
														<property name="label">Rating</property>
														<property name="halign">start</property>
														<style>
															<class name="quality-label"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:rating:min">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
												<child>
													<object class="GtkLabel">
														<property name="label">-</property>
														<style>
															<class name="quality-dash"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:rating:max">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkButton" id="button:clear-filters">
										<property name="label">Clear filters</property>
										<signal name="clicked" handler="callbacks_onFiltersClear"/>
										<style>
											<class name="clear-filters-btn"/>
										</style>
									</object>
								</child>
							</object>
						</child>
						<child>
							<object class="GtkScrolledWindow">
								<property name="hexpand">true</property>
								<property name="vexpand">true</property>
								<property name="hscrollbar-policy">automatic</property>
								<property name="vscrollbar-policy">automatic</property>
								<property name="css-classes">table-scroll</property>
								<child>
									<object class="GtkColumnView" id="table:player-list">
										<property name="css-classes">table</property>
										<property name="enable-rubberband">true</property>
									</object>
								</child>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="GtkBox">
						<property name="orientation">horizontal</property>
						<property name="hexpand">true</property>
						<style>
							<class name="status-row"/>
						</style>
						<child>
							<object class="GtkLabel" id="status:player-count">
								<property name="label"/>
								<property name="halign">end</property>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>
	</object>
</interface>
