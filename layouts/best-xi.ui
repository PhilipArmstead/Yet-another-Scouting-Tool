<?xml version="1.0" encoding="UTF-8"?>
<!--
  Yet another Scouting Tool - GTK4 GtkBuilder UI definition.
  See: https://docs.gtk.org/gtk4/class.Builder.html
-->
<interface domain="best-xi">
	<!-- interface-name best-xi.ui -->
	<!-- interface-copyright SPDX-FileCopyrightText: © 2026 Phil Armstead <philarmstead@mailbox.org>
SPDX-License-Identifier: GPL-3.0-or-later -->
	<!-- interface-authors Phil Armstead <philarmstead@mailbox.org> -->
	<requires lib="gtk" version="4.0"/>
	<object class="GtkWindow" id="window:best-xi">
		<property name="default-width">420</property>
		<property name="title">Yet another Scouting Tool - Best XI</property>
		<style>
			<class name="app-root"/>
			<class name="best-eleven-root"/>
		</style>
		<child>
			<object class="GtkAdjustment" id="adjustment:min-age">
				<property name="lower">14</property>
				<property name="upper">50</property>
				<property name="value">14</property>
				<property name="step-increment">1</property>
				<property name="page-increment">5</property>
			</object>
			<object class="GtkAdjustment" id="adjustment:max-age">
				<property name="lower">14</property>
				<property name="upper">50</property>
				<property name="value">50</property>
				<property name="step-increment">1</property>
				<property name="page-increment">5</property>
			</object>
			<object class="GtkAdjustment" id="adjustment:min-condition">
				<property name="lower">0</property>
				<property name="upper">100</property>
				<property name="value">80</property>
				<property name="step-increment">1</property>
				<property name="page-increment">5</property>
			</object>
			<object class="GtkAdjustment" id="adjustment:max-condition">
				<property name="lower">0</property>
				<property name="upper">100</property>
				<property name="value">100</property>
				<property name="step-increment">1</property>
				<property name="page-increment">5</property>
			</object>

			<object class="GtkStringList" id="string-list:formation"/>

			<object class="GtkBox">
				<property name="orientation">horizontal</property>
				<property name="spacing">20</property>
				<property name="margin-top">16</property>
				<property name="margin-bottom">16</property>
				<property name="margin-start">16</property>
				<property name="margin-end">16</property>
				<property name="hexpand">true</property>
				<property name="vexpand">true</property>

				<child>
					<object class="GtkBox">
						<property name="orientation">vertical</property>
						<property name="spacing">12</property>
						<child>
							<object class="GtkLabel">
								<property name="label">Best Eleven</property>
								<property name="halign">start</property>
								<property name="xalign">0</property>
								<style>
									<class name="title-1"/>
								</style>
							</object>
						</child>

						<child>
							<object class="GtkLabel">
								<property name="label">Select a formation and view the best available combination of players.</property>
								<property name="halign">start</property>
								<property name="xalign">0</property>
								<property name="hexpand">true</property>
								<property name="wrap">true</property>
								<style>
									<class name="dim-label"/>
								</style>
							</object>
						</child>

						<child>
							<object class="GtkBox">
								<property name="orientation">horizontal</property>
								<property name="spacing">12</property>
								<child>
									<object class="GtkLabel">
										<property name="label">Formation:</property>
										<property name="valign">center</property>
									</object>
								</child>
								<child>
									<object class="GtkDropDown" id="dropdown:formation">
										<property name="model">string-list:formation</property>
										<property name="selected">0</property>
										<property name="width-request">160</property>
										<style>
											<class name="dropdown"/>
										</style>
									</object>
								</child>
							</object>
						</child>

						<child>
							<object class="GtkScrolledWindow">
								<property name="hexpand">true</property>
								<property name="hscrollbar-policy">never</property>
								<property name="vscrollbar-policy">never</property>
								<property name="kinetic-scrolling">false</property>
								<style>
									<class name="table"/>
								</style>
								<child>
									<object class="GtkListBox" id="list-box:best-xi">
										<property name="selection-mode">none</property>
										<property name="show-separators">false</property>
										<property name="width-request">350</property>
									</object>
								</child>
							</object>
						</child>
					</object>
				</child>

				<child>
					<object class="GtkBox" id="best_eleven_sidebar">
						<property name="orientation">vertical</property>
						<property name="spacing">20</property>

						<child>
							<object class="GtkBox" id="best_eleven_filters">
								<property name="orientation">vertical</property>
								<property name="spacing">16</property>
								<style>
									<class name="card"/>
								</style>

								<child>
									<object class="GtkLabel">
										<property name="label">Filters</property>
										<property name="halign">start</property>
										<property name="xalign">0</property>
										<style>
											<class name="title-3"/>
										</style>
									</object>
								</child>

								<child>
									<object class="GtkLabel">
										<property name="label">Age</property>
										<property name="halign">start</property>
										<property name="xalign">0</property>
										<style>
											<class name="heading"/>
										</style>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="orientation">horizontal</property>
										<property name="spacing">8</property>
										<child>
											<object class="GtkBox">
												<property name="orientation">vertical</property>
												<property name="spacing">4</property>
												<child>
													<object class="GtkSpinButton" id="spin:min-age">
														<property name="adjustment">adjustment:min-age</property>
														<property name="numeric">true</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label">to</property>
												<property name="valign">end</property>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="orientation">vertical</property>
												<property name="spacing">4</property>
												<child>
													<object class="GtkSpinButton" id="spin:max-age">
														<property name="adjustment">adjustment:max-age</property>
														<property name="numeric">true</property>
													</object>
												</child>
											</object>
										</child>
									</object>
								</child>

								<child>
									<object class="GtkSeparator"/>
								</child>

								<child>
									<object class="GtkLabel">
										<property name="label">Condition (%)</property>
										<property name="halign">start</property>
										<property name="xalign">0</property>
										<style>
											<class name="heading"/>
										</style>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="orientation">horizontal</property>
										<property name="spacing">8</property>
										<child>
											<object class="GtkBox">
												<property name="orientation">vertical</property>
												<property name="spacing">4</property>
												<child>
													<object class="GtkSpinButton" id="spin:min-condition">
														<property name="adjustment">adjustment:min-condition</property>
														<property name="numeric">true</property>
														<property name="digits">0</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label">to</property>
												<property name="valign">end</property>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="orientation">vertical</property>
												<property name="spacing">4</property>
												<child>
													<object class="GtkSpinButton" id="spin:max-condition">
														<property name="adjustment">adjustment:max-condition</property>
														<property name="numeric">true</property>
														<property name="digits">0</property>
													</object>
												</child>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="orientation">horizontal</property>
										<property name="spacing">8</property>
										<child>
											<object class="GtkCheckButton" id="checkbox:best-xi:exclude-injured">
												<property name="label">Exclude injured?</property>
												<property name="halign">start</property>
												<property name="active">true</property>
												<style>
													<class name="heading"/>
												</style>
											</object>
										</child>
									</object>
								</child>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>
	</object>
</interface>