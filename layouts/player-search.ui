<?xml version="1.0" encoding="UTF-8"?>
<!--
  Yet another Scouting Tool - GTK4 GtkBuilder UI definition.
  See: https://docs.gtk.org/gtk4/class.Builder.html
-->
<interface domain="player-search">
	<!-- interface-name player-search.ui -->
	<!-- interface-copyright SPDX-FileCopyrightText: © 2026 Phil Armstead <philarmstead@mailbox.org>
SPDX-License-Identifier: GPL-3.0-or-later -->
	<!-- interface-authors Phil Armstead <philarmstead@mailbox.org> -->
	<requires lib="gtk" version="4.0"/>
	<object class="GtkPopover" id="popover:club-search">
		<property name="autohide">false</property>
		<property name="can-focus">false</property>
		<property name="position">bottom</property>
		<property name="child">
			<object class="GtkListBox" id="listbox:club-search">
				<property name="can-focus">false</property>
				<property name="selection-mode">none</property>
			</object>
		</property>
	</object>
	<object class="GtkPopover" id="popover:nationality-search">
		<property name="autohide">false</property>
		<property name="can-focus">false</property>
		<property name="position">bottom</property>
		<property name="child">
			<object class="GtkListBox" id="listbox:nationality-search">
				<property name="can-focus">false</property>
				<property name="selection-mode">none</property>
			</object>
		</property>
	</object>
	<object class="GtkWindow" id="window:player-search">
		<property name="title">Yet another Scouting Tool</property>
		<property name="default-width">1255</property>
		<property name="default-height">690</property>
		<child>
			<object class="GtkBox">
				<property name="orientation">vertical</property>
				<property name="css-classes">app-root</property>
				<child>
					<object class="GtkBox">
						<property name="css-classes">topbar</property>
						<property name="spacing">10</property>
						<child>
							<object class="GtkButton">
								<property name="label">Players</property>
								<style>
									<class name="nav-tab"/>
									<class name="nav-tab-active"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Current player</property>
								<signal name="clicked" handler="callbacks_onShowCurrentPlayer"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Best XI</property>
								<signal name="clicked" handler="callbacks_onShowBestEleven"/>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkButton">
								<property name="label">Squad Depth</property>
								<style>
									<class name="nav-tab"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkBox">
								<property name="hexpand">true</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel" id="label:date">
								<property name="label"/>
								<style>
									<class name="date"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkLabel" id="label:version">
								<property name="label"/>
								<style>
									<class name="version"/>
								</style>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="GtkBox">
						<property name="css-classes">filterbar</property>
						<property name="spacing">8</property>
						<child>
							<object class="GtkLabel" id="label:results-count">
								<style>
									<class name="results-count"/>
								</style>
							</object>
						</child>
						<child>
							<object class="GtkBox" id="box:filter-tags"/>
						</child>
						<child>
							<object class="GtkButton" id="button:clear-all">
								<property name="label">clear all</property>
								<signal name="clicked" handler="callbacks_onFiltersClear"/>
								<style>
									<class name="link-btn"/>
								</style>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="GtkBox">
						<property name="orientation">horizontal</property>
						<property name="vexpand">true</property>
						<property name="css-classes">body</property>
						<child>
							<object class="GtkBox" id="box:sidebar">
								<property name="orientation">vertical</property>
								<property name="width-request">190</property>
								<property name="spacing">6</property>
								<property name="css-classes">sidebar</property>
								<child>
									<object class="GtkLabel">
										<property name="label">FILTERS</property>
										<property name="halign">start</property>
										<property name="hexpand">false</property>
										<style>
											<class name="section-title"/>
										</style>
									</object>
								</child>

								<child>
									<object class="GtkSearchEntry" id="entry:club">
										<property name="placeholder-text">Filter by club</property>
										<property name="css-classes">sidebar-search</property>
									</object>
								</child>
								<child>
									<object class="GtkSearchEntry" id="entry:nationality">
										<property name="placeholder-text">Filter by nation</property>
										<property name="css-classes">sidebar-search</property>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="orientation">vertical</property>
										<property name="spacing">6</property>
										<property name="css-classes">quality-body</property>
										<child>
											<object class="GtkBox">
												<property name="spacing">4</property>
												<style>
													<class name="quality-row"/>
												</style>
												<child>
													<object class="GtkLabel">
														<property name="label">Age</property>
														<property name="halign">start</property>
														<style>
															<class name="quality-label"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:age:min">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
												<child>
													<object class="GtkLabel">
														<property name="label">-</property>
														<style>
															<class name="quality-dash"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:age:max">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="spacing">4</property>
												<style>
													<class name="quality-row"/>
												</style>
												<child>
													<object class="GtkLabel">
														<property name="label">CA</property>
														<property name="halign">start</property>
														<style>
															<class name="quality-label"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:ca:min">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
												<child>
													<object class="GtkLabel">
														<property name="label">-</property>
														<style>
															<class name="quality-dash"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:ca:max">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="spacing">4</property>
												<style>
													<class name="quality-row"/>
												</style>
												<child>
													<object class="GtkLabel">
														<property name="label">PA</property>
														<property name="halign">start</property>
														<style>
															<class name="quality-label"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:pa:min">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
												<child>
													<object class="GtkLabel">
														<property name="label">-</property>
														<style>
															<class name="quality-dash"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:pa:max">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="spacing">4</property>
												<style>
													<class name="quality-row"/>
												</style>
												<child>
													<object class="GtkLabel">
														<property name="label">Rating</property>
														<property name="halign">start</property>
														<style>
															<class name="quality-label"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:rating:min">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
												<child>
													<object class="GtkLabel">
														<property name="label">-</property>
														<style>
															<class name="quality-dash"/>
														</style>
													</object>
												</child>
												<child>
													<object class="GtkEntry" id="entry:rating:max">
														<property name="max-width-chars">3</property>
														<property name="width-chars">3</property>
														<property name="css-classes">quality-entry</property>
													</object>
												</child>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkLabel">
										<property name="label">POSITIONS</property>
										<property name="halign">start</property>
										<property name="hexpand">false</property>
										<style>
											<class name="section-title"/>
										</style>
									</object>
								</child>
								<child>
									<object class="GtkBox">
										<property name="orientation">vertical</property>
										<property name="spacing">6</property>
										<property name="css-classes">quality-body</property>
										<child>
											<object class="GtkGrid">
												<property name="halign">center</property>
												<property name="column-homogeneous">true</property>
												<property name="row-homogeneous">true</property>
												<property name="column-spacing">4</property>
												<property name="row-spacing">4</property>
												<style>
													<class name="position-pitch"/>
												</style>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:st">
														<property name="valign">center</property>
														<property name="margin-top">8</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">ST</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">1</property>
															<property name="row">0</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:aml">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">AML</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">0</property>
															<property name="row">1</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:amc">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">AMC</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">1</property>
															<property name="row">1</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:amr">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">AMR</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">2</property>
															<property name="row">1</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:ml">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">ML</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">0</property>
															<property name="row">2</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:mc">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">MC</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">1</property>
															<property name="row">2</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:mr">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">MR</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">2</property>
															<property name="row">2</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:wbl">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">WBL</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">0</property>
															<property name="row">3</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:dm">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">DM</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">1</property>
															<property name="row">3</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:wbr">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">WBR</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">2</property>
															<property name="row">3</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:dl">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">DL</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">0</property>
															<property name="row">4</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:dc">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">DC</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">1</property>
															<property name="row">4</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:dr">
														<property name="valign">center</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">DR</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">2</property>
															<property name="row">4</property>
														</layout>
													</object>
												</child>
												<child>
													<object class="GtkCheckButton" id="checkbox:position:gk">
														<property name="valign">center</property>
														<property name="margin-bottom">8</property>
														<property name="child">
															<object class="GtkLabel">
																<property name="label">GK</property>
																<property name="hexpand">true</property>
															</object>
														</property>
														<style>
															<class name="position-toggle"/>
														</style>
														<layout>
															<property name="column">1</property>
															<property name="row">5</property>
														</layout>
													</object>
												</child>
											</object>
										</child>
									</object>
								</child>
								<child>
									<object class="GtkButton" id="button:apply-filters">
										<property name="label">Apply filters</property>
										<signal name="clicked" handler="callbacks_onFilterRun"/>
										<style>
											<class name="btn-primary"/>
										</style>
									</object>
								</child>
								<child>
									<object class="GtkButton" id="button:clear-filters">
										<property name="label">Clear filters</property>
										<signal name="clicked" handler="callbacks_onFiltersClear"/>
										<style>
											<class name="btn-secondary"/>
										</style>
									</object>
								</child>
							</object>
						</child>
						<child>
							<object class="GtkScrolledWindow">
								<property name="hexpand">true</property>
								<property name="vexpand">true</property>
								<property name="hscrollbar-policy">automatic</property>
								<property name="vscrollbar-policy">automatic</property>
								<property name="css-classes">table-scroll</property>
								<child>
									<object class="GtkColumnView" id="table:player-list">
										<property name="css-classes">table</property>
										<property name="enable-rubberband">true</property>
									</object>
								</child>
							</object>
						</child>
					</object>
				</child>
				<child>
					<object class="GtkBox">
						<property name="orientation">horizontal</property>
						<property name="hexpand">true</property>
						<style>
							<class name="status-row"/>
						</style>
						<child>
							<object class="GtkLabel" id="label:application-status">
								<property name="label"/>
								<property name="halign">end</property>
							</object>
						</child>
						<child>
							<object class="GtkBox">
								<property name="hexpand">true</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel" id="label:application-version">
								<property name="label"/>
								<style>
									<class name="date"/>
								</style>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>
	</object>
</interface>
