find_package(Git REQUIRED)

function(yast_dependency name url tag revision)
	set(source "${PROJECT_SOURCE_DIR}/lib/${name}")
	file(MAKE_DIRECTORY "${PROJECT_SOURCE_DIR}/lib")
	file(LOCK "${PROJECT_SOURCE_DIR}/lib/.dependencies.lock" GUARD FUNCTION TIMEOUT 120)
	if (NOT EXISTS "${source}")
		execute_process(COMMAND "${GIT_EXECUTABLE}" clone --quiet --depth 1 --branch "${tag}" "${url}" "${source}"
			RESULT_VARIABLE result)
		if (NOT result EQUAL 0)
			message(FATAL_ERROR "Could not clone ${name}. Check network access, remove the incomplete lib/${name} checkout, and configure again.")
		endif ()
	endif ()
	execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
		OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
	if (NOT result EQUAL 0 OR NOT actual STREQUAL revision)
		message(FATAL_ERROR "lib/${name} must be ${tag} (${revision}), found '${actual}'. Existing checkouts are never reset automatically.")
	endif ()
	set(${name}_SOURCE_DIR "${source}" PARENT_SCOPE)
endfunction()

